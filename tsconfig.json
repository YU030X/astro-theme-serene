{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "src/**/*.astro",
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "other_base",
    ".playwright-cli"
  ],
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
