---
import EmptyState from '@/components/EmptyState.astro'
import Icon from '@/components/Icon.astro'
import PageHead from '@/components/PageHead.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { formatCategory, getCategories, getPosts } from '@/lib/utils'
import { t } from '@/lib/ui'
import { taxonomyHref } from '@/lib/taxonomy'

const posts = await getPosts()
const categories = getCategories(posts)
---

<BaseLayout title={t('nav.categories')} description={t('categories.description')}>
  <section class="pt-14 sm:pt-16">
    <PageHead title={t('nav.categories')}>
      {t('categories.summary', { count: categories.length, posts: posts.length })}
    </PageHead>

    {
      categories.length > 0 ? (
        <div class="mx-auto mt-14 grid max-w-[var(--container-reading)] gap-3 sm:grid-cols-2">
          {categories.map(({ category, count }, index) => (
            <a
              class="soft-lift no-hover-lift group flex items-center justify-between rounded-2xl border border-line bg-card px-5 py-4"
              href={taxonomyHref('categories', category)}
              style={`--reveal-delay: ${(index % 8) * 40}ms`}
              data-reveal
            >
              <span class="flex items-center gap-3 font-medium text-ink transition-colors group-hover:text-accent">
                <Icon name="layers" size={16} class="text-quiet" />
                {formatCategory(category)}
              </span>
              <span class="font-mono text-xs text-quiet">{count}</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="mx-auto max-w-[var(--container-reading)]">
          <EmptyState>
            {t('categories.empty')}
          </EmptyState>
        </div>
      )
    }
  </section>
</BaseLayout>
