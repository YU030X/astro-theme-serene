---
import type { GetStaticPaths, Page } from 'astro'

import EmptyState from '@/components/EmptyState.astro'
import PageHead from '@/components/PageHead.astro'
import Pagination from '@/components/Pagination.astro'
import PostRow from '@/components/PostRow.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPosts, type Post } from '@/lib/utils'
import { siteConfig } from '@/site.config'
import { t } from '@/lib/ui'
import { getSeries } from '@/lib/series'

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts()
  return paginate(posts, { pageSize: siteConfig.postsPerPage })
}) satisfies GetStaticPaths

const { page } = Astro.props as { page: Page<Post> }
const hasSeries = getSeries(await getPosts(), import.meta.env.DEV).length > 0
---

<BaseLayout
  title={t('nav.blog')}
  description={t('blog.description', { author: siteConfig.author })}
>
  <section class="mx-auto w-full max-w-[var(--container-reading)] pt-14 sm:pt-16">
    <PageHead title={t('nav.blog')}>
      {t('blog.summary', { count: page.total })}
      <nav
        slot="after"
        class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-3"
        aria-label={t('nav.indexes')}
      >
        <a
          class="link-underline text-[0.85rem] font-medium text-quiet"
          href="/archive">{t('nav.archive')}</a
        >
        <a
          class="link-underline text-[0.85rem] font-medium text-quiet"
          href="/categories">{t('nav.categories')}</a
        >
        <a
          class="link-underline text-[0.85rem] font-medium text-quiet"
          href="/tags">{t('nav.tags')}</a
        >
        {hasSeries && <a class="link-underline text-[0.85rem] font-medium text-quiet" href="/series">{t('series.title')}</a>}
      </nav>
    </PageHead>

    {
      page.data.length > 0 ? (
        <ul class="post-list mt-14" data-reveal="content">
          {page.data.map((post) => (
            <PostRow {post} />
          ))}
        </ul>
      ) : (
        <EmptyState>
          {t('blog.empty')}
        </EmptyState>
      )
    }

    {page.lastPage > 1 && <Pagination {page} />}
  </section>
</BaseLayout>
