---
import type { GetStaticPaths, Page } from 'astro'

import EmptyState from '@/components/EmptyState.astro'
import PageHead from '@/components/PageHead.astro'
import Pagination from '@/components/Pagination.astro'
import PostRow from '@/components/PostRow.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPosts, type Post } from '@/lib/utils'
import { siteConfig } from '@/site.config'

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts()
  return paginate(posts, { pageSize: siteConfig.postsPerPage })
}) satisfies GetStaticPaths

const { page } = Astro.props as { page: Page<Post> }
---

<BaseLayout
  title="Blog"
  description={`Writing by ${siteConfig.author} — essays on design, code and attention.`}
>
  <section class="mx-auto max-w-[var(--container-reading)] pt-14 sm:pt-16">
    <PageHead title="Blog">
      {page.total} essays on design, code, and paying attention.
      <nav
        slot="after"
        class="mt-5 flex items-center justify-center gap-6"
        aria-label="Blog indexes"
      >
        <a
          class="link-underline text-[0.85rem] font-medium text-quiet"
          href="/archive">Archive</a
        >
        <a
          class="link-underline text-[0.85rem] font-medium text-quiet"
          href="/categories">Categories</a
        >
        <a
          class="link-underline text-[0.85rem] font-medium text-quiet"
          href="/tags">Tags</a
        >
      </nav>
    </PageHead>

    {
      page.data.length > 0 ? (
        <ul class="post-list mt-14" data-reveal="content">
          {page.data.map((post) => (
            <PostRow {post} />
          ))}
        </ul>
      ) : (
        <EmptyState>
          No posts yet. Add a Markdown file to <code>src/content/blog/</code> and
          it will appear here.
        </EmptyState>
      )
    }

    {page.lastPage > 1 && <Pagination {page} />}
  </section>
</BaseLayout>
