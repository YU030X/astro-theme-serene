---
import { Image } from 'astro:assets'

import EmptyState from '@/components/EmptyState.astro'
import HomePostItem from '@/components/HomePostItem.astro'
import Icon from '@/components/Icon.astro'
import ProjectCardCompact from '@/components/ProjectCardCompact.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPosts } from '@/lib/utils'
import { projects } from '@/data/projects'
import { siteConfig } from '@/site.config'

const posts = (await getPosts()).slice(0, 7)
const featured = projects.filter((project) => project.featured)
---

<BaseLayout>
  <div class="mx-auto w-full max-w-[50rem]">
    <section class="mt-10 text-center sm:mt-14" data-reveal="masthead">
      <Image
        src={siteConfig.avatar}
        alt={`${siteConfig.title} avatar`}
        width={144}
        densities={[1, 2]}
        loading="eager"
        class="mx-auto size-20 rounded-[1.25rem] ring-1 ring-line sm:size-24"
      />
      <h1 class="mt-6 font-serif text-[2.1rem] font-medium leading-tight tracking-[-0.02em]">
        {siteConfig.title}
      </h1>
      <p class="mx-auto mt-2.5 max-w-[32rem] font-serif text-[1.05rem] italic leading-relaxed text-quiet">
        {siteConfig.motto}
      </p>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[0.8125rem] text-quiet">
        {
          siteConfig.socials.map((social) => (
            <a
              class="inline-flex items-center gap-1.5 transition-colors duration-150 hover:text-accent"
              href={social.href}
              aria-label={social.label}
              {...(social.href.startsWith('http')
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              <Icon name={social.icon} size={15} />
              <span>{social.label}</span>
            </a>
          ))
        }
        <a
          class="inline-flex items-center gap-1.5 transition-colors duration-150 hover:text-accent"
          href="/rss.xml"
          aria-label="RSS feed"
        >
          <Icon name="rss" size={15} />
          <span>RSS</span>
        </a>
      </div>
    </section>

    <div class="mt-16 space-y-12 sm:mt-20 sm:space-y-14" data-reveal="content">
      <section class="grid gap-y-4 md:grid-cols-[6rem_minmax(0,1fr)] md:gap-x-8">
        <h2 class="text-lg font-semibold tracking-tight">About</h2>
        <div class="min-w-0">
          <p class="text-sm font-medium text-ink">{siteConfig.tagline}</p>
          <p class="mt-2 text-[0.95rem] leading-[1.8] text-quiet">
            {siteConfig.bio}
          </p>
          <div class="mt-3 flex justify-end">
            <a
              href="/about"
              class="group inline-flex items-center gap-1 rounded-sm border border-line bg-card px-2.5 py-1.5 text-[0.75rem] text-quiet transition-colors duration-150 hover:border-accent/30 hover:text-accent"
            >
              More about me
              <Icon
                name="arrow-right"
                size={12}
                class="shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transform-none"
              />
            </a>
          </div>
        </div>
      </section>

      <section class="grid gap-y-4 md:grid-cols-[6rem_minmax(0,1fr)] md:gap-x-8">
        <h2 class="text-lg font-semibold tracking-tight">Posts</h2>
        <div class="min-w-0">
          {
            posts.length > 0 ? (
              <ul class="space-y-3">
                {posts.map((post) => (
                  <HomePostItem {post} />
                ))}
              </ul>
            ) : (
              <EmptyState compact>
                No posts yet — the newest seven will be listed here.
              </EmptyState>
            )
          }
          <div class="mt-3 flex justify-end">
            <a
              href="/blog"
              class="group inline-flex items-center text-[0.8125rem] text-quiet transition-colors duration-150 hover:text-accent"
            >
              <span class="inline-flex items-center gap-1.5 transition-transform duration-300 ease-out group-hover:translate-x-0.5 motion-reduce:transform-none">
                More posts
                <Icon name="arrow-right" size={13} class="shrink-0" />
              </span>
            </a>
          </div>
        </div>
      </section>

      <section class="grid gap-y-4 md:grid-cols-[6rem_minmax(0,1fr)] md:gap-x-8">
        <h2 class="text-lg font-semibold tracking-tight">Projects</h2>
        <div class="min-w-0">
          <div class="space-y-3">
            {featured.map((project) => <ProjectCardCompact {project} variant="card" />)}
          </div>
          <div class="mt-3 flex justify-end">
            <a
              href="/projects"
              class="group inline-flex items-center gap-1 rounded-sm border border-line bg-card px-2.5 py-1.5 text-[0.75rem] text-quiet transition-colors duration-150 hover:border-accent/30 hover:text-accent"
            >
              More projects
              <Icon
                name="arrow-right"
                size={12}
                class="shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transform-none"
              />
            </a>
          </div>
        </div>
      </section>
    </div>

    <p class="mt-16 pb-2 text-center text-[0.8125rem] text-quiet">
      Search anything with
      <kbd
        class="mx-0.5 rounded-xs border border-line bg-tint px-1.5 py-0.5 text-[11px]"
        >⌘K</kbd
      >, or follow along via
      <a
        class="font-medium underline decoration-line underline-offset-2 transition-colors duration-200 hover:text-accent"
        href="/rss.xml">RSS</a
      >.
    </p>
  </div>
</BaseLayout>
