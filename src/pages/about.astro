---
import PageHead from '@/components/PageHead.astro'
import ToolSection from '@/components/ToolSection.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { toolGroups } from '@/data/tools'
import { siteConfig } from '@/site.config'
---

<BaseLayout
  title="About"
  description={`${siteConfig.title} — ${siteConfig.tagline}`}
>
  <section class="pt-14 sm:pt-16" data-pagefind-body>
    <PageHead title="About">A quiet, editorial Astro theme.</PageHead>

    <div class="mx-auto mt-14 max-w-[var(--container-reading)]" data-reveal="content">
      <section>
        <h2 class="text-lg font-semibold tracking-tight">Intro</h2>
        <div class="mt-3 space-y-4 text-[0.95rem] leading-[1.85] text-quiet">
          <p>
            <strong class="text-ink">Serene</strong> is an open-source blog
            theme for Astro. It favors calm interfaces, readable prose, and
            systems simple enough to customize without a design-system
            ceremony.
          </p>
          <p>
            The <a
              class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors duration-150 hover:text-accent"
              href="/blog">sample posts</a
            >, <a
              class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors duration-150 hover:text-accent"
              href="/projects">projects</a
            >, and <a
              class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors duration-150 hover:text-accent"
              href="/links">links</a
            > on this site are demo content so you can evaluate layout, motion,
            and content plumbing before you replace them with your own writing.
          </p>
        </div>
      </section>

      <section class="mt-14">
        <h2 class="text-lg font-semibold tracking-tight">Tools</h2>
        <p class="mt-3 text-sm leading-relaxed text-quiet">
          Example stack behind this theme — edit
          <code class="rounded-xs bg-tint px-1 font-mono text-xs">src/data/tools.json</code>
          for your own tools.
        </p>
        <div class="mt-6 space-y-6">
          {toolGroups.map((group) => <ToolSection {group} />)}
        </div>
      </section>

      <section class="mt-14">
        <h2 class="text-lg font-semibold tracking-tight">Site</h2>
        <div class="mt-3 text-[0.95rem] leading-[1.85] text-quiet">
          <p>
            This demo runs on <a
              class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors duration-150 hover:text-accent"
              href="https://astro.build"
              target="_blank"
              rel="noopener noreferrer">Astro</a
            > with <strong class="text-ink">Serene</strong>: system fonts, no
            client framework, dual-theme code blocks, Pagefind search, and
            opt-in Waline comments. Start from
            <code class="rounded-xs bg-tint px-1 font-mono text-xs">src/site.config.ts</code>.
          </p>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
