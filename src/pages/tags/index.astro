---
import PageHead from '@/components/PageHead.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPosts, getTags } from '@/lib/utils'

const posts = await getPosts()
const tags = getTags(posts)
const max = tags[0]?.count ?? 1
---

<BaseLayout title="Tags" description="Browse every topic on this blog.">
  <section class="pt-14 sm:pt-16">
    <PageHead title="Tags">
      {tags.length} topics across {posts.length} posts.
    </PageHead>

    {/* Underlined word cloud — no boxes; size tracks usage. */}
    <div class="mx-auto mt-14 flex max-w-[var(--container-reading)] flex-wrap items-baseline justify-center gap-x-6 gap-y-3">
      {
        tags.map(({ tag, count }, i) => (
          <a
            class:list={[
              'font-medium underline decoration-line underline-offset-4 transition-colors duration-150 hover:text-accent',
              count === max ? 'text-ink' : 'text-quiet'
            ]}
            href={`/tags/${tag}`}
            style={`font-size: ${(0.8 + (count / max) * 0.35).toFixed(3)}rem; --reveal-delay: ${(i % 12) * 30}ms`}
            data-reveal
          >
            #{tag}
            <span class="text-[0.72em] font-normal opacity-60">{count}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
