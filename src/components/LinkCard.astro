---
import Icon from '@/components/Icon.astro'
import type { FriendLink } from '@/data/links'
import { getAvatarThemeColor } from '@/lib/image-color'

/** Friend link card: round avatar, name and intro, with the avatar blown up
 *  as a soft left backdrop. Hover tints toward the per-link theme color. */
interface Props {
  link: FriendLink
}

const { link } = Astro.props
const avatarThemeColor = link.avatar
  ? await getAvatarThemeColor(link.avatar)
  : undefined
const themeColor = avatarThemeColor
  ? `rgb(${avatarThemeColor})`
  : `hsl(${link.hue} 55% 58%)`
/* SVG brand marks are logos, not photos: fit them whole (an SVG without
   width/height has a 300x150 intrinsic size, so `cover` crops it badly). */
const avatarIsLogo =
  link.avatar?.split(/[?#]/)[0].toLowerCase().endsWith('.svg') ?? false
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  class="link-card group relative isolate flex items-center gap-3.5 overflow-hidden rounded-xl border border-line/75 bg-card px-4 py-3"
  style={`--link-theme-color: ${themeColor}`}
  aria-label={`Visit ${link.name} (opens in a new tab)`}
>
  {
    link.avatar && (
      <img
        class:list={[
          'link-card__backdrop',
          avatarIsLogo && 'link-card__backdrop--logo'
        ]}
        src={link.avatar}
        width="250"
        height="150"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        onerror="this.remove()"
      />
    )
  }

  <span
    class="link-avatar relative grid size-[3.25rem] shrink-0 select-none place-items-center overflow-hidden rounded-full border border-line bg-tint text-sm font-medium text-ink"
    aria-hidden="true"
  >
    <span>{link.name.charAt(0)}</span>
    {
      link.avatar && (
        <img
          src={link.avatar}
          alt=""
          width="52"
          height="52"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          class:list={[
            'absolute inset-0 size-full bg-card',
            avatarIsLogo ? 'object-contain p-[0.45rem]' : 'object-cover'
          ]}
          onerror="this.remove()"
        />
      )
    }
  </span>

  <span class="min-w-0 flex-1">
    <span class="link-name block truncate text-[0.95rem] font-semibold leading-5 text-ink">
      {link.name}
    </span>
    <span class="mt-1 line-clamp-1 block text-[0.8rem] leading-5 text-quiet">
      {link.description}
    </span>
  </span>

  <Icon
    name="arrow-up-right"
    size={14}
    class="link-external absolute right-3 top-3 text-quiet/70"
  />
</a>

<style>
  .link-card {
    transition:
      border-color 0.2s var(--ease-out-quart),
      background-color 0.2s var(--ease-out-quart);
  }

  .link-card:hover {
    border-color: color-mix(in srgb, var(--link-theme-color) 30%, var(--line));
    background: color-mix(in srgb, var(--card) 96%, var(--link-theme-color));
  }

  /* The avatar again, oversized and fading out rightward behind the row. */
  .link-card__backdrop {
    position: absolute;
    inset-block: 0;
    left: -0.5rem;
    width: 62%;
    height: 100%;
    z-index: -1;
    object-fit: cover;
    opacity: 0.12;
    filter: saturate(0.8);
    -webkit-mask-image: linear-gradient(to left, transparent 0%, black 100%);
    mask-image: linear-gradient(to left, transparent 0%, black 100%);
    pointer-events: none;
  }

  :global([data-theme='dark']) .link-card__backdrop {
    opacity: 0.1;
  }

  /* Logos float whole as a faint watermark instead of being crop-zoomed. */
  .link-card__backdrop--logo {
    object-fit: contain;
    padding-block: 0.5rem;
  }

  .link-avatar,
  .link-name,
  .link-external {
    transition:
      color 0.2s var(--ease-out-quart),
      border-color 0.2s var(--ease-out-quart);
  }

  .link-card:hover .link-avatar {
    border-color: color-mix(in srgb, var(--link-theme-color) 34%, var(--line));
  }

  .link-card:hover .link-name,
  .link-card:hover .link-external {
    color: color-mix(in srgb, var(--link-theme-color) 76%, var(--ink));
  }
</style>
