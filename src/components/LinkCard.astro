---
import Icon from '@/components/Icon.astro'
import type { FriendLink } from '@/data/links'
import { getAvatarThemeColor } from '@/lib/image-color'

interface Props {
  link: FriendLink
}

const { link } = Astro.props
const avatarThemeColor = link.avatar
  ? await getAvatarThemeColor(link.avatar)
  : undefined
const themeColor = avatarThemeColor
  ? `rgb(${avatarThemeColor})`
  : `hsl(${link.hue} 55% 58%)`
const avatarIsLogo =
  link.avatar?.split(/[?#]/)[0].toLowerCase().endsWith('.svg') ?? false
const domain = new URL(link.url).hostname.replace(/^www\./, '')
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  class="link-card group grid min-h-[6.75rem] min-w-0 grid-cols-[2.25rem_minmax(0,1fr)_0.875rem] grid-rows-[auto_1fr_auto] items-start gap-x-2.5 gap-y-1 overflow-hidden rounded-xl border border-line/75 bg-card px-3.5 py-3"
  style={`--link-theme-color: ${themeColor}`}
  aria-label={`Visit ${link.name} (opens in a new tab)`}
>
  <span
    class="link-avatar relative row-span-3 grid size-9 select-none place-items-center self-start overflow-hidden rounded-full border border-line bg-tint text-xs font-medium text-ink"
    aria-hidden="true"
  >
    <span>{link.name.charAt(0)}</span>
    {
      link.avatar && (
        <img
          src={link.avatar}
          alt=""
          width="36"
          height="36"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          class:list={[
            'absolute inset-0 size-full bg-card',
            avatarIsLogo ? 'object-contain p-[0.35rem]' : 'object-cover'
          ]}
          onerror="this.remove()"
        />
      )
    }
  </span>

  <span class="link-name min-w-0 truncate text-[0.875rem] font-semibold leading-5 text-ink">
    {link.name}
  </span>

  <span class="col-[2/4] line-clamp-2 min-w-0 text-[0.75rem] leading-[1.45] text-quiet">
    {link.description}
  </span>

  <span class="link-domain col-[2/4] flex min-w-0 items-center gap-1.5 font-mono text-[0.58rem] uppercase tracking-[0.09em] text-quiet/70">
    <span class="link-dot size-1 shrink-0 rounded-full" aria-hidden="true"></span>
    <span class="truncate">{domain}</span>
  </span>

  <Icon
    name="arrow-up-right"
    size={14}
    class="link-external col-start-3 row-start-1 mt-0.5 text-quiet/65"
  />
</a>

<style>
  .link-card {
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 0.18s var(--ease-out-quart),
      background-color 0.18s var(--ease-out-quart);
  }

  .link-card:hover,
  .link-card:focus-visible {
    border-color: color-mix(in srgb, var(--line) 88%, var(--card));
    background: color-mix(in srgb, var(--card) 94%, var(--link-theme-color));
  }

  .link-dot {
    background: var(--link-theme-color);
    opacity: 0.72;
  }

  .link-avatar,
  .link-name,
  .link-domain,
  .link-external,
  .link-dot {
    transition:
      color 0.2s var(--ease-out-quart),
      border-color 0.2s var(--ease-out-quart),
      opacity 0.2s var(--ease-out-quart);
  }

  .link-card:hover .link-avatar,
  .link-card:focus-visible .link-avatar {
    border-color: color-mix(in srgb, var(--link-theme-color) 34%, var(--line));
  }

  .link-card:hover .link-name,
  .link-card:hover .link-domain,
  .link-card:hover .link-external,
  .link-card:focus-visible .link-name,
  .link-card:focus-visible .link-domain,
  .link-card:focus-visible .link-external {
    color: color-mix(in srgb, var(--link-theme-color) 76%, var(--ink));
  }

  .link-card:hover .link-dot,
  .link-card:focus-visible .link-dot {
    opacity: 1;
  }
</style>
