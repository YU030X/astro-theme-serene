---
import Icon from '@/components/Icon.astro'
import type { FriendLink } from '@/data/links'
import { getAvatarThemeColor } from '@/lib/image-color'
import { t } from '@/lib/ui'

interface Props {
  link: FriendLink
}

const { link } = Astro.props
const avatarThemeColor = link.avatar
  ? await getAvatarThemeColor(link.avatar)
  : undefined
const themeColor = avatarThemeColor
  ? `rgb(${avatarThemeColor})`
  : `hsl(${link.hue} 55% 58%)`
const avatarIsLogo =
  link.avatar?.split(/[?#]/)[0].toLowerCase().endsWith('.svg') ?? false
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  class="link-card group flex min-h-[6.25rem] min-w-0 items-center gap-3 overflow-hidden rounded-xl border border-line/75 bg-card p-4"
  style={`--link-theme-color: ${themeColor}`}
  aria-label={t('link.visit', { name: link.name })}
>
  <span
    class="link-avatar relative grid size-10 shrink-0 select-none place-items-center overflow-hidden rounded-full border border-line bg-tint text-xs font-medium text-ink"
    aria-hidden="true"
  >
    <span>{link.name.charAt(0)}</span>
    {
      link.avatar && (
        <img
          src={link.avatar}
          alt=""
          width="40"
          height="40"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          class:list={[
            'absolute inset-0 size-full bg-card',
            avatarIsLogo ? 'object-contain p-[0.4rem]' : 'object-cover'
          ]}
        />
      )
    }
  </span>

  <span class="flex min-w-0 flex-1 flex-col justify-center gap-1">
    <span class="flex min-w-0 items-center justify-between gap-1.5">
      <span class="link-name min-w-0 truncate text-[1rem] font-normal leading-snug text-ink">
        {link.name}
      </span>
      <Icon
        name="arrow-up-right"
        size={14}
        class="link-external shrink-0 text-quiet/65"
      />
    </span>
    <span class="link-description line-clamp-2 min-w-0 text-[0.78rem] leading-[1.5] text-quiet">
      {link.description}
    </span>
  </span>
</a>

<style>
  .link-card {
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 0.18s var(--ease-out-quart),
      background-color 0.18s var(--ease-out-quart);
  }

  .link-card:hover,
  .link-card:focus-visible {
    border-color: color-mix(in srgb, var(--line) 88%, var(--card));
    background: color-mix(in srgb, var(--card) 94%, var(--link-theme-color));
  }

  /* `data-image-error` is set by setupImageLoading() in scripts/app.ts. */
  .link-avatar :global(img[data-image-error]) {
    display: none;
  }

  .link-avatar,
  .link-name,
  .link-external {
    transition:
      color 0.2s var(--ease-out-quart),
      border-color 0.2s var(--ease-out-quart);
  }

  .link-card:hover .link-avatar,
  .link-card:focus-visible .link-avatar {
    border-color: color-mix(in srgb, var(--link-theme-color) 34%, var(--line));
  }

  .link-card:hover .link-name,
  .link-card:hover .link-external,
  .link-card:focus-visible .link-name,
  .link-card:focus-visible .link-external {
    color: color-mix(in srgb, var(--link-theme-color) 76%, var(--ink));
  }
</style>
