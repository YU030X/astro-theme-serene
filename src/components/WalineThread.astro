---
// Must keep `?url` and the hand-written <link> below. A plain
// `import '@waline/client/style'` is a style side effect, and Astro collects
// those from the whole reachable module graph — dynamic imports included — so
// it would link 22 KB of Waline into every article with comments switched off.
import walineStyleUrl from '@waline/client/style?url'
import { t } from '@/lib/ui'

interface Props {
  serverURL: string
}

const { serverURL } = Astro.props
---

<link rel="stylesheet" href={walineStyleUrl} />

<section class="mx-auto mt-16 max-w-[var(--container-reading)]" data-pagefind-ignore>
  <h2 class="mb-5 font-serif text-section font-semibold tracking-tight text-ink">
    {t('comments.title')}
  </h2>
  <p data-waline-status role="status" class="text-sm text-muted">{t('comments.loading')}</p>
  <div id="waline-thread" data-waline-server={serverURL} aria-busy="true"></div>
</section>

<script>
  import { t } from '@/lib/client-i18n'
  type WalineInstance = {
    update: (opts: Record<string, unknown>) => void
    destroy: () => void
  }
  let walineInstance: WalineInstance | null = null
  let activeElement: HTMLElement | null = null
  let generation = 0
  let themeObserver: MutationObserver | null = null
  let contentObserver: MutationObserver | null = null
  let loadingTimer: number | undefined

  const currentTheme = () =>
    document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'

  // Imported here rather than at module scope: a static import is collected
  // into the page's stylesheet and script even when comments are switched
  // off, so the whole of Waline rode along on every article. Inside the
  // function it becomes a chunk that is only fetched once a thread mounts.
  async function mountWaline() {
    const el = document.getElementById('waline-thread')
    if (!el || el === activeElement) return
    const serverURL = el.dataset.walineServer
    teardownWaline()
    activeElement = el
    const ownGeneration = generation
    const path = window.location.pathname
    const status = el.parentElement?.querySelector<HTMLElement>('[data-waline-status]')
    const isCurrent = () => generation === ownGeneration && el.isConnected && activeElement === el
    const fail = () => {
      if (!isCurrent()) return
      teardownWaline()
      el.setAttribute('aria-busy', 'false')
      el.dataset.state = 'error'
      if (status) {
        status.hidden = false
        status.textContent = t('comments.error')
      }
    }
    if (!serverURL) { fail(); return }
    loadingTimer = window.setTimeout(fail, 15_000)
    try {
      const { init } = await import('@waline/client')
      if (!isCurrent()) return
      walineInstance = init({
        el,
        serverURL,
        path,
        dark: currentTheme() === 'dark',
        reaction: false,
        lang: document.documentElement.dataset.uiLocale === 'zh-CN' ? 'zh-CN' : 'en-US',
        locale: { refresh: t('comments.retry') }
      }) as WalineInstance | null
      if (!walineInstance) throw new Error('Comments could not initialize')
      // Waline v3 exposes request state through the list's loading / retry UI.
      // Observe only that list (not the editor's emoji loader). Integration
      // tests exercise real Waline DOM so an upstream markup change is caught.
      const reflectState = () => {
        if (!isCurrent()) return
        const list = el.querySelector('[data-waline]')
        if (!list) return
        const loading = !!list.querySelector(':scope > .wl-loading')
        const retry = list.querySelector(':scope > .wl-operation > button')?.textContent === t('comments.retry')
        el.setAttribute('aria-busy', String(loading))
        el.dataset.state = loading ? 'loading' : retry ? 'error' : 'ready'
        if (loading) {
          loadingTimer ??= window.setTimeout(fail, 15_000)
        } else {
          window.clearTimeout(loadingTimer)
          loadingTimer = undefined
        }
        if (status) {
          status.hidden = !loading && !retry
          status.textContent = t(loading ? 'comments.loading' : 'comments.retryHint')
        }
      }
      contentObserver = new MutationObserver(reflectState)
      contentObserver.observe(el, { childList: true, subtree: true })
      reflectState()
      themeObserver = new MutationObserver(() => {
        if (isCurrent()) walineInstance?.update({ dark: currentTheme() === 'dark' })
      })
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme']
      })
    } catch {
      fail()
    }
  }

  function teardownWaline() {
    generation += 1
    window.clearTimeout(loadingTimer)
    loadingTimer = undefined
    themeObserver?.disconnect()
    themeObserver = null
    contentObserver?.disconnect()
    contentObserver = null
    walineInstance?.destroy()
    walineInstance = null
    activeElement = null
  }

  document.addEventListener('astro:page-load', () => void mountWaline())
  document.addEventListener('astro:before-swap', teardownWaline)
  void mountWaline()
</script>

{/* Waline's DOM is runtime-injected and never gets Astro's scoped attribute — must stay is:global. */}
<style is:global>
  #waline-thread {
    --waline-font-size: 0.95rem;
    --waline-theme-color: var(--accent);
    --waline-active-color: var(--accent-hover);
    --waline-color: var(--ink);
    --waline-bg-color: var(--card);
    --waline-bg-color-light: var(--tint);
    --waline-bg-color-hover: var(--tint);
    --waline-border-color: var(--line);
    --waline-border: 1px solid var(--line);
    --waline-avatar-radius: 9999px;
    --waline-box-shadow: none;
  }
  #waline-thread .wl-content,
  #waline-thread .wl-comment-text {
    word-break: break-word;
    overflow-wrap: anywhere;
  }
  /* RSS links + "Powered by Waline" credit. */
  #waline-thread .wl-rss,
  #waline-thread .wl-power {
    display: none !important;
  }
</style>
