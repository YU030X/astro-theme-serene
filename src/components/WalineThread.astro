---
// Must keep `?url` and the hand-written <link> below. A plain
// `import '@waline/client/style'` is a style side effect, and Astro collects
// those from the whole reachable module graph — dynamic imports included — so
// it would link 22 KB of Waline into every article with comments switched off.
import walineStyleUrl from '@waline/client/style?url'

interface Props {
  serverURL: string
}

const { serverURL } = Astro.props
---

<link rel="stylesheet" href={walineStyleUrl} />

<section class="mx-auto mt-16 max-w-[var(--container-reading)]" data-pagefind-ignore>
  <h2 class="mb-5 font-serif text-section font-semibold tracking-tight text-ink">
    Comments
  </h2>
  <div id="waline-thread" data-waline-server={serverURL}></div>
</section>

<script>
  type WalineInstance = {
    update: (opts: Record<string, unknown>) => void
    destroy: () => void
  }
  let walineInstance: WalineInstance | null = null

  const currentTheme = () =>
    document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'

  // Imported here rather than at module scope: a static import is collected
  // into the page's stylesheet and script even when comments are switched
  // off, so the whole of Waline rode along on every article. Inside the
  // function it becomes a chunk that is only fetched once a thread mounts.
  async function mountWaline() {
    const el = document.getElementById('waline-thread')
    if (!el) return
    const serverURL = el.dataset.walineServer
    if (!serverURL) return

    const { init } = await import('@waline/client')

    // Guard against a soft navigation completing during the await.
    if (!document.getElementById('waline-thread')) return

    walineInstance = init({
      el: '#waline-thread',
      serverURL,
      path: window.location.pathname,
      dark: "[data-theme='dark']",
      reaction: false
    }) as WalineInstance | null
  }

  function teardownWaline() {
    walineInstance?.destroy()
    walineInstance = null
  }

  document.addEventListener('astro:page-load', () => void mountWaline())
  document.addEventListener('astro:before-swap', teardownWaline)

  new MutationObserver(() => {
    walineInstance?.update({ dark: currentTheme() === 'dark' })
  }).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme']
  })
</script>

{/* Waline's DOM is runtime-injected and never gets Astro's scoped attribute — must stay is:global. */}
<style is:global>
  #waline-thread {
    --waline-font-size: 0.95rem;
    --waline-theme-color: var(--accent);
    --waline-active-color: var(--accent-hover);
    --waline-color: var(--ink);
    --waline-bg-color: var(--card);
    --waline-bg-color-light: var(--tint);
    --waline-bg-color-hover: var(--tint);
    --waline-border-color: var(--line);
    --waline-border: 1px solid var(--line);
    --waline-avatar-radius: 9999px;
    --waline-box-shadow: none;
  }
  #waline-thread .wl-content,
  #waline-thread .wl-comment-text {
    word-break: break-word;
    overflow-wrap: anywhere;
  }
  /* RSS links + "Powered by Waline" credit. */
  #waline-thread .wl-rss,
  #waline-thread .wl-power {
    display: none !important;
  }
</style>
