---
import DraftBadge from '@/components/DraftBadge.astro'
import FormattedDate from '@/components/FormattedDate.astro'
import Icon from '@/components/Icon.astro'
import type { Post } from '@/lib/utils'

interface Props {
  post: Post
}

const { post } = Astro.props
const isDraft = post.data.draft && import.meta.env.DEV
---

<li>
  <a
    href={`/blog/${post.id}`}
    class="group grid min-h-11 grid-cols-[5.5rem_minmax(0,1fr)_1rem] items-center gap-x-2 rounded-[0.9rem] border border-line bg-card px-3.5 py-2 transition-colors duration-150 hover:border-accent/25 hover:bg-tint sm:grid-cols-[5.75rem_minmax(0,1fr)_1rem] sm:gap-x-4 sm:px-4"
  >
    <FormattedDate
      date={post.data.publishDate}
      options={{ month: 'short', day: 'numeric', year: 'numeric' }}
      class="col-start-1 row-start-1 whitespace-nowrap font-mono text-[0.72rem] tabular-nums text-quiet"
    />
    <span
      class="col-start-2 row-start-1 flex min-w-0 items-center gap-2 text-left text-[0.875rem] leading-snug text-ink transition-colors duration-150 group-hover:text-accent sm:text-[0.9rem]"
    >
      <span class="min-w-0 truncate">{post.data.title}</span>
      {isDraft && <DraftBadge />}
    </span>
    <Icon
      name="arrow-right"
      size={14}
      class="col-start-3 row-start-1 self-center justify-self-end text-quiet/65 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-accent"
    />
  </a>
</li>
