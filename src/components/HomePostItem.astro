---
import DraftBadge from '@/components/DraftBadge.astro'
import FormattedDate from '@/components/FormattedDate.astro'
import type { Post } from '@/lib/utils'

interface Props {
  post: Post
}

const { post } = Astro.props
const isDraft = post.data.draft && import.meta.env.DEV
---

<li>
  <a
    href={`/blog/${post.id}`}
    class="group -mx-3 grid grid-cols-[minmax(0,1fr)] gap-x-3 gap-y-0.5 rounded-lg px-3 py-2 transition-colors duration-150 hover:bg-tint sm:grid-cols-[5.75rem_minmax(0,1fr)] sm:items-baseline"
  >
    <FormattedDate
      date={post.data.publishDate}
      options={{ month: 'short', day: 'numeric', year: 'numeric' }}
      class="col-start-1 row-start-1 font-mono text-[0.72rem] tabular-nums text-quiet sm:col-auto sm:row-auto"
    />
    <span
      class="col-start-1 row-start-2 flex min-w-0 items-center gap-2 text-[0.94rem] leading-snug text-ink transition-colors duration-150 group-hover:text-accent sm:col-start-2 sm:row-start-1"
    >
      <span class="min-w-0 truncate">{post.data.title}</span>
      {isDraft && <DraftBadge />}
    </span>
  </a>
</li>
