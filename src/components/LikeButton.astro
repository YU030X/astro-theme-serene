---
import Icon from '@/components/Icon.astro'
import { siteConfig } from '@/site.config'

interface Props {
  /** Render as one action in the article license footer. */
  compact?: boolean
}

const { compact = false } = Astro.props
const { enabled, serverURL } = siteConfig.waline
const active = enabled && serverURL.length > 0
---

{
  active && (
    <div
      class:list={['like-button', compact && 'like-button-compact']}
      data-pagefind-ignore
    >
      <button
        type="button"
        class="like-toggle"
        data-like
        data-waline-server={serverURL}
        aria-pressed="false"
        aria-label="Like this post"
      >
        <Icon name="heart" size={18} class="like-heart" />
        <span class="like-count" data-like-count aria-live="polite">0</span>
      </button>
    </div>
  )
}

<script>
  // Waline article-counter API (no extra backend):
  //   GET  api/article?path=…&type=reaction0  → read count
  //   POST api/article {path,type:'reaction0'[,action:'desc']} → +1 / -1
  const REACTION_TYPE = 'reaction0'
  const storageKey = (path: string) => `serene:like:${path}`

  function setupLikeButton() {
    const button = document.querySelector<HTMLButtonElement>('[data-like]')
    if (!button || button.dataset.enhanced === 'true') return
    button.dataset.enhanced = 'true'

    const serverURL = button.dataset.walineServer
    const countEl = button.querySelector<HTMLElement>('[data-like-count]')
    if (!serverURL || !countEl) return
    const base = serverURL.replace(/\/$/, '')
    const path = window.location.pathname
    let liked = false
    let count = 0
    let busy = false
    try {
      liked = localStorage.getItem(storageKey(path)) === '1'
    } catch {
      /* storage blocked */
    }
    button.setAttribute('aria-pressed', String(liked))
    button.classList.toggle('is-liked', liked)
    const render = () => {
      countEl.textContent = String(count)
      button.setAttribute('aria-pressed', String(liked))
      button.classList.toggle('is-liked', liked)
    }
    const loadCount = async () => {
      try {
        const url = new URL('api/article', `${base}/`)
        url.searchParams.set('path', path)
        url.searchParams.set('type', REACTION_TYPE)
        url.searchParams.set('lang', navigator.language)
        const response = await fetch(url)
        if (!response.ok) return
        const payload = await response.json()
        const data = Array.isArray(payload?.data) ? payload.data : payload
        const value = Array.isArray(data) ? data[0]?.[REACTION_TYPE] : undefined
        if (typeof value === 'number' && Number.isFinite(value)) {
          count = value
          render()
        }
      } catch {
        /* offline or blocked — keep the optimistic value */
      }
    }
    const vote = async () => {
      if (busy) return
      busy = true
      const nextLiked = !liked
      liked = nextLiked
      count = Math.max(0, count + (nextLiked ? 1 : -1))
      render()
      try {
        localStorage.setItem(storageKey(path), nextLiked ? '1' : '0')
      } catch {
        /* ignore */
      }
      try {
        const url = new URL('api/article', `${base}/`)
        url.searchParams.set('lang', navigator.language)
        const response = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            path,
            type: REACTION_TYPE,
            action: nextLiked ? undefined : 'desc'
          }),
          keepalive: true
        })
        // fetch only rejects on network failure, never on a 4xx or 5xx.
        if (!response.ok) throw new Error(`Vote failed: ${response.status}`)
      } catch {
        liked = !nextLiked
        count = Math.max(0, count + (nextLiked ? -1 : 1))
        try {
          localStorage.setItem(storageKey(path), liked ? '1' : '0')
        } catch {
          /* ignore */
        }
        render()
      } finally {
        busy = false
      }
    }
    button.addEventListener('click', vote)
    void loadCount()
  }
  document.addEventListener('astro:page-load', setupLikeButton)
</script>
<style>
  .like-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--line);
    background: var(--card);
    padding: 0.5rem 1.1rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--quiet);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition:
      color 0.2s var(--ease-out-quart),
      border-color 0.2s var(--ease-out-quart),
      background-color 0.2s var(--ease-out-quart),
      transform 0.12s var(--ease-spring);
  }
  .like-toggle:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }
  .like-toggle:active {
    transform: scale(0.96);
  }
  .like-button {
    display: flex;
    max-width: var(--container-reading);
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin: 2.5rem auto 0;
  }
  .like-button-compact {
    display: flex;
    max-width: none;
    flex: none;
    flex-direction: row;
    margin: 0;
  }
  .like-button-compact .like-toggle {
    min-height: 2.15rem;
    padding: 0.35rem 0.65rem;
    border-color: transparent;
    background: transparent;
  }
  /* Matches .license-action, which sits beside it. */
  @media (pointer: coarse) {
    .like-button-compact .like-toggle {
      min-height: 2.75rem;
    }
  }
  .like-button-compact .like-toggle:hover,
  .like-button-compact .like-toggle:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 30%, var(--line));
    background: var(--card);
  }
  .like-toggle .like-heart {
    transition:
      transform 0.2s var(--ease-spring),
      fill 0.2s var(--ease-out-quart),
      color 0.2s var(--ease-out-quart);
  }
  .like-toggle.is-liked {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
  }
  .like-toggle.is-liked .like-heart {
    fill: var(--accent);
    color: var(--accent);
    transform: scale(1.08);
  }
  .like-count {
    font-variant-numeric: tabular-nums;
  }
</style>
