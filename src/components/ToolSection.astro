---
import type { ToolGroup } from '@/data/tools'

/** Type-specimen tool list: a borderless run of text with inline icons.
 *  Icons render grayscale and regain color on hover. */
interface Props {
  group: ToolGroup
}

const { group } = Astro.props

// tool.icon must match an @/assets/tools/*.svg basename; missing → no icon.
const iconModules = import.meta.glob<string>('@/assets/tools/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true
})
const iconMarkup: Record<string, string> = {}
for (const [path, raw] of Object.entries(iconModules)) {
  const basename = path.split('/').pop()?.replace(/\.svg$/, '')
  if (basename) iconMarkup[basename] = raw
}
---

<section
  class="tool-group"
  aria-labelledby={`tool-group-${group.title.toLowerCase().replace(/\s+/g, '-')}`}
>
  <h3
    id={`tool-group-${group.title.toLowerCase().replace(/\s+/g, '-')}`}
    class="document-eyebrow"
  >
    {group.title}
  </h3>

  <p class="tool-flow">
    {
      group.tools.map((tool, i) => {
        const Tag = tool.href ? 'a' : 'span'
        const svg = tool.icon ? iconMarkup[tool.icon] : undefined

        return (
          <>
            {i > 0 && (
              <span class="tool-sep" aria-hidden="true">
                ·
              </span>
            )}
            <Tag
              class="tool-item"
              {...(tool.href
                ? { href: tool.href, target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              {svg && <span class="tool-icon" aria-hidden="true" set:html={svg} />}
              <span class:list={[tool.strikethrough && 'line-through decoration-quiet/70']}>
                {tool.name}
              </span>
            </Tag>
          </>
        )
      })
    }
  </p>
</section>

<style>
  .tool-flow {
    margin-top: 0.45rem;
    font-size: 0.95rem;
    line-height: 2.2;
    color: var(--quiet);
  }

  .tool-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--ink);
    font-weight: 500;
  }

  a.tool-item {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ink) 18%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
    transition:
      color 0.2s var(--ease-out-quart),
      text-decoration-color 0.2s var(--ease-out-quart);
  }

  a.tool-item:hover {
    color: var(--accent);
    text-decoration-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .tool-icon {
    display: inline-grid;
    place-items: center;
    width: 1.05em;
    height: 1.05em;
    filter: grayscale(1);
    opacity: 0.72;
    transition:
      filter 0.25s var(--ease-out-quart),
      opacity 0.25s var(--ease-out-quart);
  }

  .tool-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  a.tool-item:hover .tool-icon {
    filter: none;
    opacity: 1;
  }

  .tool-sep {
    margin-inline: 0.65em;
    font-size: 1.15em;
    font-weight: 600;
    color: color-mix(in srgb, var(--quiet) 45%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    a.tool-item,
    .tool-icon {
      transition: none;
    }
  }
</style>
