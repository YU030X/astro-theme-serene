---
import { siteConfig } from '@/site.config'

export interface ArticleMeta {
  publishDate: Date
  updatedDate?: Date
  category?: string
  tags?: string[]
}

interface Props {
  title?: string
  description?: string
  /** Absolute or root-relative path to the social image. */
  ogImage?: string
  article?: ArticleMeta
  /** Keep the page out of search results (error pages, thin routes). */
  noindex?: boolean
}

const {
  title,
  description = siteConfig.description,
  ogImage,
  article,
  noindex = false
} = Astro.props

const pageTitle = title
  ? `${siteConfig.title} ${siteConfig.titleDelimiter} ${title}`
  : `${siteConfig.title} ${siteConfig.titleDelimiter} ${siteConfig.tagline}`

const canonical = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL(ogImage ?? '/og-default.jpg', Astro.site)
const publisher = {
  '@type': 'Organization',
  name: siteConfig.title,
  url: siteConfig.site,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/avatar.svg', Astro.site).toString()
  }
}

const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonical.toString(),
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonical.toString()
      },
      image: socialImage.toString(),
      datePublished: article.publishDate.toISOString(),
      dateModified: (article.updatedDate ?? article.publishDate).toISOString(),
      author: {
        '@type': 'Person',
        name: siteConfig.author,
        url: siteConfig.authorUrl
      },
      publisher,
      inLanguage: siteConfig.locale,
      articleSection: article.category,
      keywords: article.tags?.join(', ')
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteConfig.title,
      description: siteConfig.description,
      url: new URL('/', Astro.site).toString()
    }

// JSON.stringify leaves `<` intact, so a title containing `</script>` would
// close this element early. Escaping it keeps the JSON valid either way.
const jsonLdScript = JSON.stringify(jsonLd).replace(/</g, '\\u003c')
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={siteConfig.author} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical} />

<link rel="icon" href="/avatar.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteConfig.title}
  href={new URL('rss.xml', Astro.site)}
/>

{/* The theme is chosen by the user, not by the OS, so a single tag carries
    both values and the boot script picks one. Keep in step with --canvas. */}
<meta
  name="theme-color"
  content="#f7f7f5"
  data-theme-color-light="#f7f7f5"
  data-theme-color-dark="#242220"
/>

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:title" content={title ?? siteConfig.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:locale" content={siteConfig.locale.replace('-', '_')} />
{
  article && (
    <>
      <meta
        property="article:published_time"
        content={article.publishDate.toISOString()}
      />
      {article.updatedDate && (
        <meta
          property="article:modified_time"
          content={article.updatedDate.toISOString()}
        />
      )}
      {article.category && (
        <meta property="article:section" content={article.category} />
      )}
      {article.tags?.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? siteConfig.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<script is:inline type="application/ld+json" set:html={jsonLdScript}></script>
