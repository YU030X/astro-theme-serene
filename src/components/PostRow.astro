---
import { Image } from 'astro:assets'

import DraftBadge from '@/components/DraftBadge.astro'
import FormattedDate from '@/components/FormattedDate.astro'
import { formatCategory, readingTime, type Post } from '@/lib/utils'

/** Open list entry: text left, 4:3 thumbnail right, no card box. */
interface Props {
  post: Post
}

const { post } = Astro.props
const { title, description, publishDate, cover, category, tags } =
  post.data
const href = `/blog/${post.id}`
const minutes = readingTime(post.body)
const isDraft = post.data.draft && import.meta.env.DEV
---

<li>
  <a
    href={href}
    class="group -mx-3.5 flex items-center gap-5 rounded-xl px-3.5 py-3.5 transition-colors duration-150 hover:bg-tint"
  >
    <span class="min-w-0 flex-1">
      <span class="flex min-w-0 flex-wrap items-center gap-2 text-[1.02rem] font-medium leading-snug text-ink transition-colors duration-150 group-hover:text-accent">
        <span>{title}</span>
        {isDraft && <DraftBadge />}
      </span>
      <span class="mt-1 line-clamp-2 text-sm leading-relaxed text-quiet">
        {description}
      </span>
      <span class="os-nums mt-2 grid gap-x-4 gap-y-1 text-[0.8rem] text-quiet sm:grid-cols-[9.5rem_minmax(0,1fr)]">
        <span class="post-meta-date flex items-baseline gap-1.5">
          <FormattedDate date={publishDate} />
          <span class="opacity-45" aria-hidden="true">·</span>
          <span>{minutes} min</span>
        </span>
        <span class="flex items-baseline gap-2">
          <span class="post-meta-cat">{formatCategory(category)}</span>
          {tags.length > 0 && (
            <span class="post-meta-tags opacity-70">
              {tags.slice(0, 2).map((tag) => `#${tag}`).join(' ')}
            </span>
          )}
        </span>
      </span>
    </span>

    {
      cover && (
        <span class="block h-[4.1rem] w-[5.45rem] shrink-0 overflow-hidden rounded-lg sm:h-[5.6rem] sm:w-[7.5rem]">
          {typeof cover.src === 'string' ? (
            <img
              src={cover.src}
              alt={cover.alt}
              width="240"
              height="180"
              loading="lazy"
              decoding="async"
              class="media-dim size-full object-cover transition-transform duration-500 ease-spring group-hover:scale-[1.04]"
            />
          ) : (
            <Image
              src={cover.src}
              alt={cover.alt}
              width={240}
              widths={[176, 240, 480]}
              sizes="(min-width: 640px) 120px, 87px"
              loading="lazy"
              class="media-dim size-full object-cover transition-transform duration-500 ease-spring group-hover:scale-[1.04]"
            />
          )}
        </span>
      )
    }
  </a>
</li>
