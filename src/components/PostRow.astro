---
import { Image } from 'astro:assets'

import DraftBadge from '@/components/DraftBadge.astro'
import FormattedDate from '@/components/FormattedDate.astro'
import { formatCategory, readingTime, type Post } from '@/lib/utils'
import { t } from '@/lib/ui'

/** Open list entry: text left, 4:3 thumbnail right, no card box. */
interface Props {
  post: Post
}

const { post } = Astro.props
const { title, description, publishDate, cover, category, tags } =
  post.data
const href = `/blog/${post.id}`
const minutes = readingTime(post.body)
const isDraft = post.data.draft && import.meta.env.DEV
---

<li>
  <a
    href={href}
    class="group -mx-3.5 flex items-center gap-5 rounded-xl px-3.5 py-3.5 transition-colors duration-150 hover:bg-tint"
  >
    <span class="min-w-0 flex-1">
      <span class="flex min-w-0 flex-wrap items-center gap-2 text-[1.02rem] font-medium leading-snug text-ink transition-colors duration-150 group-hover:text-accent">
        <span>{title}</span>
        {isDraft && <DraftBadge />}
      </span>
      <span class="mt-1 line-clamp-2 text-sm leading-relaxed text-quiet">
        {description}
      </span>
      <span class="os-nums mt-2 flex flex-wrap items-baseline gap-x-1.5 gap-y-1 text-[0.8rem] text-quiet">
        <span class="post-meta-date inline-flex items-baseline gap-1.5">
          <FormattedDate date={publishDate} />
          <span class="opacity-45" aria-hidden="true">·</span>
          <span>{t('post.minutes', { count: minutes })}</span>
        </span>
        <span class="opacity-45" aria-hidden="true">·</span>
        <span class="post-meta-cat font-normal">{formatCategory(category)}</span>
        {
          tags.length > 0 && (
            <span class="post-meta-tags ml-0.5 font-normal">
              {tags.slice(0, 2).map((tag) => `#${tag}`).join(' ')}
            </span>
          )
        }
      </span>
    </span>

    {
      cover && (
        <span class="post-row-thumb media-dim block h-[4.125rem] w-[5.5rem] shrink-0 overflow-hidden rounded-lg sm:h-[5.625rem] sm:w-[7.5rem]">
          {typeof cover.src === 'string' ? (
            <img
              src={cover.src}
              alt={cover.alt}
              width="240"
              height="180"
              loading="lazy"
              decoding="async"
              class="size-full object-cover"
            />
          ) : (
            <Image
              src={cover.src}
              alt={cover.alt}
              width={240}
              widths={[176, 240, 480]}
              sizes="(min-width: 640px) 120px, 88px"
              loading="lazy"
              class="size-full object-cover"
            />
          )}
        </span>
      )
    }
  </a>
</li>

<style>
  /* Isolate the rounded clip and dark-mode filter on the outer box, and keep
     the image permanently composited so hover-out never demotes the GPU layer
     and snaps object-fit: cover cropping at transitionend. */
  .post-row-thumb {
    transform: translateZ(0);
  }

  .post-row-thumb :global(img) {
    will-change: transform;
    backface-visibility: hidden;
    transform: translateZ(0) scale(1);
    transition: transform 0.5s var(--ease-spring);
  }

  a:hover .post-row-thumb :global(img) {
    transform: translateZ(0) scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .post-row-thumb :global(img) {
      transition: none;
    }
    a:hover .post-row-thumb :global(img) {
      transform: translateZ(0) scale(1);
    }
  }
</style>
