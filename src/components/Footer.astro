---
import Icon from '@/components/Icon.astro'
import { siteConfig } from '@/site.config'
import { t } from '@/lib/ui'

const year = new Date().getFullYear()
const secondaryLinks = [
  { label: t('nav.blog'), href: '/blog' },
  { label: t('nav.archive'), href: '/archive' },
  { label: t('nav.tags'), href: '/tags' },
  { label: 'RSS', href: '/rss.xml' }
]
---

<footer class="mt-20 sm:mt-24" data-pagefind-ignore>
  {/* Mirrors the page structure (padded 70rem shell → reading column) so the
      footer text sits exactly on the content axis. */}
  <div class="footer-shell mx-auto w-full max-w-[70rem]">
    <div class="mx-auto w-full max-w-[var(--container-reading)] border-t border-line/70 py-6">
    <div class="flex items-center justify-between gap-3 text-[0.8rem] text-quiet">
      <nav class="flex flex-wrap gap-x-3 gap-y-2 sm:gap-x-5" aria-label={t('nav.footer')}>
        {
          secondaryLinks.map((link) => (
            <a class="transition-colors hover:text-ink" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="flex shrink-0 items-center gap-0.5">
        {
          siteConfig.socials.map((social) => (
            <a
              class="icon-btn"
              href={social.href}
              aria-label={social.label}
              {...(social.href.startsWith('http')
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              <Icon name={social.icon} size={18} />
            </a>
          ))
        }
        <a class="icon-btn" href="/rss.xml" aria-label={t('common.rss')}>
          <Icon name="rss" size={18} />
        </a>
      </div>
    </div>
    <div class="mt-3 flex flex-col gap-2 text-[0.8rem] text-quiet sm:flex-row sm:items-baseline sm:justify-between">
      <p class="order-last text-center sm:order-first sm:text-left">© {year} {siteConfig.author}. All rights reserved.</p>
      <p class="order-first text-center sm:order-last sm:text-right">
        {t('footer.built')}{' '}
        <a
          class="font-medium transition-colors hover:text-ink"
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer">Astro</a
        >
        {' '}· {t('footer.theme')}{' '}
        <a
          class="font-medium transition-colors hover:text-ink"
          href={siteConfig.repository}
          target="_blank"
          rel="noopener noreferrer">Serene</a
        >
      </p>
    </div>
    </div>
  </div>
</footer>
