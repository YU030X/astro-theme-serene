---
import Icon from '@/components/Icon.astro'
import { siteConfig } from '@/site.config'

const year = new Date().getFullYear()
const secondaryLinks = [
  { label: 'Blog', href: '/blog' },
  { label: 'Archive', href: '/archive' },
  { label: 'Tags', href: '/tags' },
  { label: 'RSS', href: '/rss.xml' }
]
---

<footer class="mt-20 sm:mt-24" data-pagefind-ignore>
  {/* Mirrors the page structure (padded 70rem shell → reading column) so the
      footer text sits exactly on the content axis. */}
  <div class="footer-shell mx-auto w-full max-w-[70rem]">
    <div class="mx-auto w-full max-w-[var(--container-reading)] border-t border-line/70 py-10">
    <div
      class="flex flex-col gap-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <p class="text-sm text-quiet">
          © {year} {siteConfig.author}.
        </p>
      </div>
      <div class="flex items-center gap-0.5">
        {
          siteConfig.socials.map((social) => (
            <a
              class="icon-btn"
              href={social.href}
              aria-label={social.label}
              {...(social.href.startsWith('http')
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              <Icon name={social.icon} size={18} />
            </a>
          ))
        }
        <a class="icon-btn" href="/rss.xml" aria-label="RSS feed">
          <Icon name="rss" size={18} />
        </a>
      </div>
    </div>

    <div
      class="mt-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 text-[0.8rem] text-quiet"
    >
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer">
        {
          secondaryLinks.map((link) => (
            <a class="transition-colors hover:text-ink" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </nav>
      <p>
        Built with{' '}
        <a
          class="font-medium transition-colors hover:text-ink"
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer">Astro</a
        >
        · Theme{' '}
        <a
          class="font-medium transition-colors hover:text-ink"
          href={siteConfig.repository}
          target="_blank"
          rel="noopener noreferrer">Serene</a
        >
      </p>
    </div>
    </div>
  </div>
</footer>
